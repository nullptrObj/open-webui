# DO NOT TRACK
# 为了对用户隐私的重视，默认禁用所有形式的数据收集和跟踪。如果需要启用分析功能（通常不建议），可以将这些环境变量设置为 false。
SCARF_NO_ANALYTICS=true         # 禁用 Scarf 分析
DO_NOT_TRACK=true               # 启用通用的"请勿跟踪"设置
ANONYMIZED_TELEMETRY=false      # 禁用匿名遥测数据收集

ENABLE_RAG_WEB_SEARCH=true
# ENABLE_OPENAI_API=false
ENABLE_OLLAMA_API=false
OFFLINE_MODE=true
# ENABLE_REALTIME_CHAT_SAVE=true

WEBUI_AUTH=true

ENABLE_TITLE_GENERATION=false       # 默认关闭自动生成标题
ENABLE_TAGS_GENERATION=false        # 默认关闭自动生成对话标签
ENABLE_CODE_INTERPRETER=false       # 默认关闭代码解释器
ENABLE_FOLLOW_UP_GENERATION=false   # 关闭问题追问功能

# 应用启动的默认端口号
PORT=8901
